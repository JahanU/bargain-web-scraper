# Supabase → Project Settings → Database → Connection string → "Session pooler" (port 5432).
# Session mode is required: the scrape lock is a session-level Postgres advisory lock.
DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-eu-west-2.pooler.supabase.com:5432/postgres

# Shared secret Supabase cron sends as "Authorization: Bearer <CRON_SECRET>" to POST /jobs/scrape.
# Generate with: openssl rand -hex 32
CRON_SECRET=

PORT=8000

# Lowest discount (%) the deals endpoint returns.
MIN_DISCOUNT=30
