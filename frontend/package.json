{
  "name": "bargain-frontend",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "dev:mock": "vp dev --mode mock",
    "build": "vp build",
    "preview": "vp preview",
    "test": "vp test",
    "test:e2e": "playwright test",
    "size": "size-limit",
    "check": "vp check && vp test --coverage && vp build && size-limit",
    "ci": "bun run check && bun run test:e2e --project=chromium",
    "check:commit": "vp check",
    "check:push": "bun run check",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/query-sync-storage-persister": "5.106.1",
    "@tanstack/react-query": "5.106.1",
    "@tanstack/react-query-persist-client": "5.106.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.69.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@size-limit/file": "14.3.0",
    "@tailwindcss/vite": "4.3.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitest/coverage-v8": "5.1.0",
    "jsdom": "30.1.3",
    "msw": "3.0.3",
    "oxc-transform-react": "0.156.0",
    "size-limit": "14.3.0",
    "tailwindcss": "4.3.4",
    "typescript": "7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vite-plus": "1.5.0",
    "vitest-axe": "0.1.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vitest": "5.1.0"
  },
  "packageManager": "bun@1.4.4"
}
