# All optional.
PORT=8000

# Lowest discount (%) the deals endpoint returns.
MIN_DISCOUNT=30

# How often to scrape. After a failure it retries sooner (15s, doubling, up to this).
SCRAPE_INTERVAL_MINUTES=5

# How much to log: debug | info | warn | error | silent. debug adds JD's internal steps and health pings.
LOG_LEVEL=info
