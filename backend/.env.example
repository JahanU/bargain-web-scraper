PORT=8000

# Where the catalogue is saved. On Render's free tier the disk is wiped on every
# restart and deploy, and the app re-scrapes on boot.
DATA_FILE=./data/deals.json

# Lowest discount (%) the deals endpoint returns.
MIN_DISCOUNT=30

SCRAPE_INTERVAL_MINUTES=5

# Optional: enables POST /jobs/scrape (Authorization: Bearer <CRON_SECRET>) for manual runs.
# Generate with: openssl rand -hex 32
CRON_SECRET=
