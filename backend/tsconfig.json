{
  "compilerOptions": {
    // Bun runs TypeScript directly; tsc only type-checks (`bun run typecheck`).
    "lib": ["ESNext"],
    "target": "ESNext",
    "module": "Preserve",
    "moduleDetection": "force",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,
    "types": ["bun-types"],

    // `@/x` means `src/x`. Bun resolves this from tsconfig natively, at runtime and in tests.
    "paths": {
      "@/*": ["./src/*"]
    },

    // Strictness
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src", "test"]
}
